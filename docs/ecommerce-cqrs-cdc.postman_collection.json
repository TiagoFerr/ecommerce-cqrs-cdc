{
  "info": {
    "_postman_id": "b3e0e14a-71d5-4ad9-bce2-68b209e74ce9",
    "name": "E-Commerce CQRS Lab (via API Gateway)",
    "description": "Coleção de requisições unificadas no API Gateway (Porta 3000). O Gateway roteia automaticamente Commands para o Write Service (3001) e Queries para o Read Service (3002).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API Gateway & Observability",
      "item": [
        {
          "name": "Healthcheck Consolidado (Gateway + Downstream)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Commands (Write Operations via Gateway)",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teclado Mecânico RGB\",\n  \"description\": \"Switch Brown silencioso ABNT2\",\n  \"price\": 350.00,\n  \"stock\": 15\n}"
            },
            "url": {
              "raw": "http://localhost:3000/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["products"]
            }
          }
        },
        {
          "name": "Create Order (ACID Check & Stock Deduction)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Tiago Ferreira\",\n  \"items\": [\n    {\n      \"productId\": \"COLE_AQUI_O_ID_DO_PRODUTO\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:3000/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["orders"]
            }
          }
        }
      ]
    },
    {
      "name": "Queries (Read Operations via Gateway)",
      "item": [
        {
          "name": "List Products (Filtros Opcionais)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/products?search=Teclado&minPrice=100&maxPrice=500",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["products"],
              "query": [
                {
                  "key": "search",
                  "value": "Teclado"
                },
                {
                  "key": "minPrice",
                  "value": "100"
                },
                {
                  "key": "maxPrice",
                  "value": "500"
                }
              ]
            }
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/products/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["products", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "COLE_AQUI_O_ID_DO_PRODUTO"
                }
              ]
            }
          }
        },
        {
          "name": "Get Order By ID (Aggregated Projection)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/orders/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["orders", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "COLE_AQUI_O_ID_DO_PEDIDO"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
